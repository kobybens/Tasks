# Local development: SQLite file. Production (Turso): libsql://<db>-<org>.turso.io
DATABASE_URL=file:data/family.db
# Only needed for Turso
DATABASE_AUTH_TOKEN=
# Random string, 32+ characters
SESSION_SECRET=change-me-to-a-long-random-string
# Created on first start if the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PORT=3000
