# Local development: embedded Postgres stored in data/pg. Production (Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=pglite://data/pg
# Random string, 32+ characters
SESSION_SECRET=change-me-to-a-long-random-string
# Created on first start if the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PORT=3000
